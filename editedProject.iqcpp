{"mode":"Text","hardwareTarget":"brain","textContent":"#pragma region VEXcode Generated Robot Configuration\n// Make sure all required headers are included.\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdbool.h>\n#include <math.h>\n#include <string.h>\n\n\n#include \"vex.h\"\n\nusing namespace vex;\n\n// Brain should be defined by default\nbrain Brain;\n\n\n// START IQ MACROS\n#define waitUntil(condition)                                                   \\\n  do {                                                                         \\\n    wait(5, msec);                                                             \\\n  } while (!(condition))\n\n#define repeat(iterations)                                                     \\\n  for (int iterator = 0; iterator < iterations; iterator++)\n// END IQ MACROS\n\n\n// Robot configuration code.\ninertial BrainInertial = inertial();\ntouchled TouchLED3 = touchled(PORT3);\n\n\n// generating and setting random seed\nvoid initializeRandomSeed(){\n  wait(100,msec);\n  double xAxis = BrainInertial.acceleration(xaxis) * 1000;\n  double yAxis = BrainInertial.acceleration(yaxis) * 1000;\n  double zAxis = BrainInertial.acceleration(zaxis) * 1000;\n  // Combine these values into a single integer\n  int seed = int(\n    xAxis + yAxis + zAxis\n  );\n  // Set the seed\n  srand(seed); \n}\n\n\n\nvoid vexcodeInit() {\n\n  // Initializing random seed.\n  initializeRandomSeed(); \n}\n\n#pragma endregion VEXcode Generated Robot Configuration\n\nusing namespace vex;\n\n// ---- config.h ----\n// Initialize the brain, motors, and sensors necessary for toggling the robot on and off\n\ntouchled touchSensor(PORT12);\n\n// ---- capsule.h ----\n// Initialize all sensors and motors pertaining to the capsule system\nconst double CAPSULE_INTERVAL = 0.25;\n\ntimer capsuleTimer;\nmotor capsuleTopMotor(PORT1, false);\nmotor capsuleBottomMotor(PORT2, true);\noptical capsuleOptical(PORT4);\n\n// ---- feeder.h ----\n// Initialize all sensors, timer, and motors pertaining to the feeder system\nconst double FEEDER_INTERVAL = 0.25;\ntimer feederTimer;\nmotor feederMotor(PORT6, false);\n\n// ---- cracker.h ----\nmotor crackerMotor(PORT5, false);\n\n// ---- counter.h ----\nbumper counterBumper(PORT7);\n\n// ---- helpers ----\n// Spins a motor until it reaches targetDeg OR timeoutSec passes, whichever comes first.\n// This guarantees a stalled/unplugged/jammed motor can never hang the program.\n// forward: waits until position >= targetDeg. reverse: waits until position <= targetDeg.\nvoid spinUntil(motor &m, directionType dir, double speedPct, double targetDeg, double timeoutSec) {\n    timer timeout;\n    timeout.clear();\n\n    m.spin(dir, speedPct, percent);\n\n    if (dir == forward) {\n        while (m.position(degrees) < targetDeg && timeout.time(seconds) < timeoutSec) {\n            wait(5, msec);\n        }\n    } else {\n        while (m.position(degrees) > targetDeg && timeout.time(seconds) < timeoutSec) {\n            wait(5, msec);\n        }\n    }\n\n    m.stop(brake);\n}\n\n// ---- config.cpp ----\n// Function to calibrate all sensors and motors\nvoid calibrateSensors() {\n    // Implementation for sensor calibration\n    touchSensor.on(red);\n    BrainInertial.resetRotation();\n}\n\n// Non-blocking emergency stop check: only reacts if the button is already pressed.\nbool eStopActivated() {\n    if (touchSensor.pressing()) {\n        while (touchSensor.pressing()) { wait(5, msec); } // wait for release\n\n        Brain.Screen.clearScreen();\n        Brain.Screen.setCursor(1, 1);\n        Brain.Screen.print(\"Emergency Stop Activated!\");\n        return true;\n    }\n\n    return false;\n}\n\n// ---- capsule.cpp ----\nbool checkCapsuleState() {\n\n    capsuleOptical.setLight(ledState::on);\n    capsuleTimer.clear();\n    \n    while (capsuleTimer.time(seconds) < CAPSULE_INTERVAL*5) { // checks for 1.25 seconds if the capsule is empty or not\n        Brain.Screen.clearScreen();\n        Brain.Screen.setCursor(1, 1);\n        \n        // NOTE: this condition is true for every hue value (anything is <= 20 OR >= 5),\n        // so it always reports \"Object detected\". Left unchanged so behavior matches your\n        // working version. To really test for red-ish hues, use: hue() <= 20 || hue() >= 340\n        if (capsuleOptical.hue() <= 20 || capsuleOptical.hue() >= 5) {\n            Brain.Screen.print(\"Object detected!\");\n            return true; // Egg detected, capsule is not empty\n\n        } else {\n            Brain.Screen.print(\"Not white.\"); // No egg detected\n        }\n\n        wait(20, msec);\n    }\n\n    Brain.Screen.clearScreen();\n    Brain.Screen.setCursor(1, 1);\n    Brain.Screen.print(\"Capsule is empty!\");\n    return false; // No egg detected, capsule is empty\n}\n\n// 5% speed is slow (roughly 30 deg/s), so these get a longer timeout.\nvoid moveTopMotor(float angle){\n    capsuleTopMotor.resetPosition();\n    if (angle < 0){\n        spinUntil(capsuleTopMotor, reverse, 5, angle, 10);\n    } else {\n        spinUntil(capsuleTopMotor, forward, 5, angle, 10);\n    }\n}\n\nvoid moveBottomMotor(float angle){\n    capsuleBottomMotor.resetPosition();\n    if (angle < 0){\n        spinUntil(capsuleBottomMotor, reverse, 5, angle, 10);\n    } else {\n        spinUntil(capsuleBottomMotor, forward, 5, angle, 10);\n    }\n}\n\nvoid dropEgg() {\n\n    moveBottomMotor(-90);\n    capsuleTimer.clear();\n\n    while (capsuleTimer.time(seconds) <= CAPSULE_INTERVAL) { wait(5, msec); }\n\n    moveBottomMotor(90);\n    capsuleTimer.clear();\n\n}\n\n// ---- feeder.cpp ----\nvoid closeFeeder() {\n    // Implementation for closing the feeder\n    feederMotor.resetPosition();\n    feederTimer.clear();\n\n    while (feederTimer.time(seconds) <= FEEDER_INTERVAL) { wait(5, msec); } // short pause before starting the feeder motor\n\n    spinUntil(feederMotor, reverse, 25, -100, 3);\n\n    Brain.Screen.clearScreen();\n    Brain.Screen.setCursor(1, 1);\n    Brain.Screen.print(\"Close pos: %.1f\", feederMotor.position(degrees));\n}\n\nvoid openFeeder() {\n    // Implementation for opening the feeder\n    feederMotor.resetPosition();\n    feederTimer.clear();\n\n    while (feederTimer.time(seconds) <= FEEDER_INTERVAL) { wait(5, msec); } // short pause before starting the feeder motor\n\n    spinUntil(feederMotor, forward, 25, 100, 3);\n\n    Brain.Screen.clearScreen();\n    Brain.Screen.setCursor(1, 1);\n    Brain.Screen.print(\"Open pos: %.1f\", feederMotor.position(degrees));\n}\n\n// ---- cracker.cpp ----\nvoid crackEgg() {\n    // Implementation for cracking the egg\n    crackerMotor.resetPosition();\n\n    spinUntil(crackerMotor, forward, 100, 180, 3);\n    spinUntil(crackerMotor, reverse, 100, 0, 3);\n}\n\n// ---- counter.cpp ----\n// Function to count the number of eggs (FAULTY, PLEASE REWRITE)\nvoid countEggs(int& eggCount) {\n\n    while (!counterBumper.pressing()) { wait(5, msec); }\n    eggCount += 1;\n    while (counterBumper.pressing()) { wait(5, msec); }\n\n    Brain.Screen.print(\"%d\", eggCount);\n}\n\n// Function to check if all eggs have been cracked\nbool allEggsCracked(int eggCount) {\n\n    // Logic to determine if all eggs have been cracked\n    if (eggCount == 0) {\n        return true;\n    } else {\n        return false;\n    }\n}\n\n// ---- main.cpp ----\nint main() {\n    vexcodeInit();\n    \n    while (!Brain.buttonCheck.pressing()) { wait(5, msec); } // Waiting for the user to press the button to start the program\n    while (Brain.buttonCheck.pressing()) { wait(5, msec); }\n\n    // Initial calibration\n    int eggCount = 0;\n    calibrateSensors();\n   \n    Brain.Screen.clearScreen();\n    Brain.Screen.setCursor(1, 1);\n    Brain.Screen.print(\"Load all eggs into the capsule and press the button to start cracking!\");\n    countEggs(eggCount);\n\n\n    while (!touchSensor.pressing()) { wait(5, msec); } // Wait for the touch sensor to be pressed, then released, before starting the main loop\n    while (touchSensor.pressing()) { wait(5, msec); }\n\n    touchSensor.on(green);\n\n    while (!eStopActivated() && !allEggsCracked(eggCount)) { // Main loop continues until emergency stop is activated or all eggs are cracked\n\n        // open feeder and move capsule\n        moveTopMotor(90);\n        openFeeder();\n        closeFeeder();\n\n        if (checkCapsuleState()) {\n            moveTopMotor(-90);\n            crackEgg();\n            eggCount -= 1;\n            dropEgg();\n        }\n\n    }\n\n    touchSensor.off();\n    Brain.Screen.clearScreen();\n    Brain.Screen.setCursor(1, 1);\n    Brain.Screen.print(\"Program stopped.\");\n    Brain.programStop();\n\n}","textLanguage":"cpp","robotConfig":[],"slot":4,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.68.1","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}